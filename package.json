{
  "name": "screengoblin",
  "version": "0.1.0",
  "private": true,
  "description": "Android-first digital signage management platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n api,console,player -c green,cyan,yellow \"npm run dev -w @screengoblin/api\" \"npm run dev -w @screengoblin/console\" \"npm run dev -w @screengoblin/player\"",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:repository && npm run test --workspaces --if-present",
    "test:repository": "node --test deploy/scripts/*.test.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:integration:postgres": "npm run test:integration -w @screengoblin/api",
    "test:e2e:console": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:container-inputs": "node deploy/scripts/validate-container-inputs.mjs",
    "validate:gradle-integrity": "node deploy/scripts/validate-gradle-integrity.mjs",
    "validate:static-security-policy": "node deploy/scripts/validate-static-security-policy.mjs",
    "validate": "npm run validate:container-inputs && npm run validate:gradle-integrity && npm run validate:static-security-policy && npm run prisma:generate -w @screengoblin/api && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
