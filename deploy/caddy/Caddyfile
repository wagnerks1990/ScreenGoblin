{
  admin off
  email {$ACME_EMAIL:}
}

{$SCREEN_GOBLIN_HOST:localhost} {
  encode zstd gzip

  @readiness path /health/ready
  handle @readiness {
    respond 404
  }

  @legacyMedia path /media /media/*
  handle @legacyMedia {
    respond 404
  }

  @api path /api /api/* /health/live
  handle @api {
    reverse_proxy api:3001
  }

  handle {
    reverse_proxy console:8080
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
}

{$PLAYER_HOST:player.localhost} {
  encode zstd gzip
  reverse_proxy player-web:8080
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
}
