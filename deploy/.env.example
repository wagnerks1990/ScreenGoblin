# Copy to deploy/.env. Generate every secret; do not reuse the example values.
SCREEN_GOBLIN_HOST=signage.example.org
PLAYER_HOST=player.signage.example.org
POSTGRES_DB=screengoblin
POSTGRES_USER=screengoblin
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode reserved characters in the password portion.
DATABASE_URL=postgresql://screengoblin:replace-with-a-long-random-password@postgres:5432/screengoblin?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
PAIRING_CODE_PEPPER=replace-with-a-separate-at-least-32-character-secret
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MANIFEST_SIGNING_PRIVATE_KEY=replace-with-a-base64url-encoded-32-byte-seed
MINIO_ROOT_USER=screengoblin-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
S3_BUCKET=screengoblin-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=screengoblin-api
S3_SECRET_ACCESS_KEY=replace-with-a-different-long-random-password
S3_PUBLIC_BASE_URL=https://signage.example.org/media
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
SEED_ADMIN_NAME=Initial Administrator
SEED_ORGANIZATION_NAME=Example Organization
SEED_ORGANIZATION_SLUG=example-organization
LOG_LEVEL=info
# Safety default. The prototype must not activate emergency messaging.
EMERGENCY_FEATURE_ENABLED=false
