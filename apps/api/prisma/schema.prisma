generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  PUBLISHER
  VIEWER
}

enum ScreenStatus {
  ONLINE
  WARNING
  OFFLINE
  FALLBACK
}

enum Orientation {
  LANDSCAPE
  PORTRAIT
}

enum MediaKind {
  IMAGE
  VIDEO
  WEB
  TEMPLATE
}

enum SchedulePriority {
  NORMAL
  CAMPAIGN
  PRIORITY
  EMERGENCY
}

enum PairingStatus {
  PENDING
  CLAIMED
  EXPIRED
  REVOKED
}

enum PairingPurpose {
  NEW_SCREEN
  REENROLL
}

enum ReleaseAssignmentState {
  ASSIGNED
  WITHDRAWN
}

enum DeviceAuthOperation {
  HEARTBEAT
  MANIFEST
}

enum LoginFailureReason {
  INVALID_CREDENTIALS
  RATE_LIMITED
}

enum IdempotencyOperation {
  SCHEDULE_PUBLISH
  RELEASE_CANDIDATE_CREATE
  RELEASE_CANDIDATE_SUBMIT
  RELEASE_CANDIDATE_APPROVE
  RELEASE_CANDIDATE_PUBLISH
  SCREEN_ENROLLMENT_CREATE
  SCREEN_ENROLLMENT_ACTIVATE
}

enum ReleaseCandidateState {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

enum AuthorizationMode {
  LEGACY
  SHADOW
  SCOPED
}

enum AuthorizationScopeType {
  ORGANIZATION
  LOCATION
  SCREEN_GROUP
  SCREEN
}

enum AccessGrantCreatorKind {
  USER
  SYSTEM
}

enum UserSessionPurpose {
  FULL
  BOOTSTRAP_PASSWORD_ROTATION
}

model Organization {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  authorizationMode      AuthorizationMode       @default(LEGACY)
  memberships            Membership[]
  membershipAttributions MembershipAttribution[]
  locations              Location[]
  screenGroups           ScreenGroup[]
  screenGroupMembers     ScreenGroupMember[]
  accessGrants           AccessGrant[]
  screens                Screen[]
  media                  MediaAsset[]
  playlists              Playlist[]
  schedules              Schedule[]
  pairings               PairingCode[]
  emergencies            EmergencyOverride[]
  audits                 AuditEvent[]
  publishedReleases      PublishedRelease[]
  releaseAssignments     ReleaseAssignment[]
  releaseCandidates      ReleaseCandidate[]
  deviceCredentials      DeviceCredential[]
  deviceAuthChallenges   DeviceAuthChallenge[]
  pairingAttempts        PairingAttempt[]
  idempotencyRecords     IdempotencyRecord[]
}

model IdempotencyRecord {
  id                  String               @id @default(cuid())
  organizationId      String
  operation           IdempotencyOperation
  keyHash             String
  actorUserId         String
  requestDigestSha256 String
  statusCode          Int
  responseBody        Json?
  expiresAt           DateTime
  createdAt           DateTime             @default(now())
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, operation, keyHash])
  /// A custom migration also creates a partial (expiresAt, id) index for rows
  /// whose responseBody is not NULL, plus an organization-leading equivalent
  /// for enrollment maintenance; Prisma cannot express partial indexes.
  @@index([expiresAt, id])
}

model Location {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  screens        Screen[]
  accessGrants   AccessGrant[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
}

model User {
  id                         String       @id @default(cuid())
  /// A custom migration also enforces UNIQUE (LOWER(email)); Prisma cannot
  /// currently express this functional index in the schema DSL.
  email                      String       @unique
  name                       String
  passwordHash               String
  authenticationEpoch        Int          @default(0)
  bootstrapPasswordExpiresAt DateTime?
  disabledAt                 DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  memberships                Membership[]
  audits                     AuditEvent[]
}

model Membership {
  id                 String        @id @default(cuid())
  organizationId     String
  userId             String
  role               OrgRole
  authorizationEpoch Int           @default(0)
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSessions       UserSession[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId, userId])
  @@index([userId])
}

/// Durable, tenant-scoped principal attribution. A database trigger creates
/// one row for every Membership and custom guards preserve it until its owning
/// Organization is deleted.
model MembershipAttribution {
  organizationId            String
  userId                    String
  recordedAt                DateTime                      @default(now())
  organization              Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishedReleases         PublishedRelease[]            @relation("PublishedReleaseCreatorAttribution")
  releaseAssignments        ReleaseAssignment[]           @relation("ReleaseAssignmentCreatorAttribution")
  authoredReleaseCandidates ReleaseCandidate[]            @relation("ReleaseCandidateAuthorAttribution")
  releaseApprovals          ReleaseApproval[]             @relation("ReleaseApprovalApproverAttribution")
  releasePublications       ReleaseCandidatePublication[] @relation("ReleaseCandidatePublisherAttribution")
  accessGrants              AccessGrant[]                 @relation("AccessGrantSubjectAttribution")
  createdAccessGrants       AccessGrant[]                 @relation("AccessGrantCreatorAttribution")

  @@id([organizationId, userId])
  @@index([userId])
}

model LoginFailureEvent {
  id         String             @id @default(cuid())
  accountKey String
  sourceKey  String
  reason     LoginFailureReason
  occurredAt DateTime           @default(now())

  @@index([accountKey, occurredAt])
  @@index([sourceKey, occurredAt])
  @@index([occurredAt])
}

model UserSession {
  id                  String             @id @default(cuid())
  organizationId      String
  userId              String
  tokenHash           String             @unique
  authenticationEpoch Int
  authorizationEpoch  Int
  purpose             UserSessionPurpose @default(FULL)
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime           @default(now())
  membership          Membership         @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model Screen {
  id                       String                    @id @default(cuid())
  organizationId           String
  name                     String
  location                 String                    @default("")
  locationId               String?
  status                   ScreenStatus              @default(OFFLINE)
  orientation              Orientation               @default(LANDSCAPE)
  resolution               String                    @default("1920x1080")
  tags                     String[]                  @default([])
  installationId           String?                   @unique
  deviceTokenHash          String?
  model                    String?
  osVersion                String?
  playerVersion            String?
  manifestVersion          String?
  nowPlayingAssetId        String?
  uptimeSeconds            BigInt?
  freeStorageBytes         BigInt?
  networkType              String?
  lastSeenAt               DateTime?
  credentialRevokedAt      DateTime?
  credentialGeneration     Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classifiedLocation       Location?                 @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: NoAction)
  schedules                ScheduleTarget[]
  pairingCodes             PairingCode[]             @relation("PairingResultScreen")
  reenrollmentGrants       PairingCode[]             @relation("PairingTargetScreen")
  releaseAssignmentTargets ReleaseAssignmentTarget[]
  releaseCandidateTargets  ReleaseCandidateTarget[]
  deviceCredentials        DeviceCredential[]
  screenGroupMembers       ScreenGroupMember[]
  accessGrants             AccessGrant[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, locationId])
}

/// A flat, tenant-bound screen collection. Nested groups are deliberately not
/// supported; deleted groups remain as provenance until their grants are
/// explicitly revoked.
model ScreenGroup {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  version        Int                 @default(0)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ScreenGroupMember[]
  accessGrants   AccessGrant[]

  @@unique([id, organizationId])
  @@index([organizationId, deletedAt, name])
}

model ScreenGroupMember {
  organizationId String
  groupId        String
  screenId       String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group          ScreenGroup  @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: NoAction)
  screen         Screen       @relation(fields: [screenId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@id([groupId, screenId])
  @@index([organizationId, screenId])
}

/// Additive grant foundation. Runtime enforcement remains on the legacy role
/// adapter until a later reviewed migration enables shadow/scoped modes.
model AccessGrant {
  id                  String                 @id @default(cuid())
  organizationId      String
  subjectUserId       String
  /// Exact live Membership instance. A custom composite foreign key clears
  /// only this field on membership deletion so a later re-add cannot revive
  /// the retained grant. Prisma cannot express column-selective SET NULL.
  subjectMembershipId String?
  capability          String
  scopeType           AuthorizationScopeType
  locationId          String?
  screenGroupId       String?
  screenId            String?
  startsAt            DateTime               @default(now())
  expiresAt           DateTime?
  revokedAt           DateTime?
  creatorKind         AccessGrantCreatorKind @default(USER)
  createdByUserId     String?
  createdBySystemKey  String?
  createdAt           DateTime               @default(now())
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject             MembershipAttribution  @relation("AccessGrantSubjectAttribution", fields: [organizationId, subjectUserId], references: [organizationId, userId], onDelete: NoAction)
  createdBy           MembershipAttribution? @relation("AccessGrantCreatorAttribution", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: NoAction)
  location            Location?              @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: NoAction)
  screenGroup         ScreenGroup?           @relation(fields: [screenGroupId, organizationId], references: [id, organizationId], onDelete: NoAction)
  screen              Screen?                @relation(fields: [screenId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([id, organizationId])
  @@index([organizationId, subjectUserId, capability, revokedAt, startsAt, expiresAt], map: "AccessGrant_active_subject_capability_idx")
  @@index([organizationId, locationId])
  @@index([organizationId, screenGroupId])
  @@index([organizationId, screenId])
}

model PairingCode {
  id                              String           @id @default(cuid())
  organizationId                  String
  screenId                        String?
  screenOrganizationId            String?
  purpose                         PairingPurpose   @default(NEW_SCREEN)
  targetScreenId                  String?
  targetScreenReferenceId         String?
  targetOrganizationId            String?
  expectedGeneration              Int?
  authorizedByUserId              String?
  authorizedByMembershipId        String?
  authorizedByAuthenticationEpoch Int?
  authorizedByAuthorizationEpoch  Int?
  priorCredentialId               String?
  requestReason                   String?
  codeHash                        String
  status                          PairingStatus    @default(PENDING)
  expiresAt                       DateTime
  claimedAt                       DateTime?
  createdAt                       DateTime         @default(now())
  organization                    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  screen                          Screen?          @relation("PairingResultScreen", fields: [screenId, screenOrganizationId], references: [id, organizationId], onDelete: SetNull)
  targetScreen                    Screen?          @relation("PairingTargetScreen", fields: [targetScreenId, targetOrganizationId], references: [id, organizationId], onDelete: SetNull)
  attempts                        PairingAttempt[]

  @@unique([id, organizationId])
  @@index([organizationId, status, expiresAt])
  @@index([codeHash])
  @@index([targetScreenId, targetOrganizationId, status])
  @@index([organizationId, authorizedByUserId, status])
}

model DeviceCredential {
  id                       String                @id @default(cuid())
  organizationId           String
  screenId                 String
  liveScreenId             String?
  liveScreenOrganizationId String?
  keyId                    String                @unique
  publicKeySpki            Bytes
  algorithm                String                @default("ES256")
  securityLevel            String
  expiresAt                DateTime?
  revokedAt                DateTime?
  createdAt                DateTime              @default(now())
  organization             Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  liveScreen               Screen?               @relation(fields: [liveScreenId, liveScreenOrganizationId], references: [id, organizationId], onDelete: SetNull)
  challenges               DeviceAuthChallenge[]
  pairingAttempt           PairingAttempt?

  @@unique([id, organizationId])
  @@unique([liveScreenId, liveScreenOrganizationId])
  @@index([organizationId, liveScreenId, revokedAt, expiresAt])
  @@index([organizationId, screenId, createdAt])
}

/// Organization-independent key history. This intentionally survives tenant
/// deletion so a previously enrolled hardware key can never be reused.
model DeviceKeyTombstone {
  keyId       String   @id
  firstSeenAt DateTime @default(now())
}

model PairingAttempt {
  id                     String            @id
  organizationId         String
  pairingCodeId          String
  keyId                  String
  publicKeySpki          Bytes
  algorithm              String            @default("ES256")
  securityLevel          String
  credentialExpiresAt    DateTime?
  challengeHashSha256    String            @unique
  /// Domain-separated HMAC-SHA256 using PAIRING_CODE_PEPPER; never a plain code digest.
  transcriptDigestSha256 String
  expiresAt              DateTime
  consumedAt             DateTime?
  provedAt               DateTime?
  activatedAt            DateTime?
  cancelledAt            DateTime?
  installationId         String?
  model                  String?
  osVersion              String?
  playerVersion          String?
  boundCredentialId      String?
  createdAt              DateTime          @default(now())
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pairingCode            PairingCode       @relation(fields: [pairingCodeId, organizationId], references: [id, organizationId], onDelete: Cascade)
  boundCredential        DeviceCredential? @relation(fields: [boundCredentialId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([boundCredentialId, organizationId])
  @@index([organizationId, pairingCodeId, expiresAt, consumedAt])
  @@index([expiresAt])
}

model DeviceAuthChallenge {
  id                  String              @id
  organizationId      String
  credentialId        String
  challengeHashSha256 String              @unique
  operation           DeviceAuthOperation
  requestDigestSha256 String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime            @default(now())
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential          DeviceCredential    @relation(fields: [credentialId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, credentialId, expiresAt, consumedAt])
  @@index([expiresAt, id])
}

model MediaAsset {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String
  kind               MediaKind
  mimeType           String
  url                String
  storageKey         String
  checksumSha256     String
  sizeBytes          BigInt
  durationSeconds    Int?
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playlistItems      PlaylistItem[]
  frozenReleaseItems FrozenReleaseItem[]

  @@unique([id, organizationId])
  @@unique([organizationId, storageKey])
  @@index([organizationId, createdAt])
}

model Playlist {
  id                String             @id @default(cuid())
  organizationId    String
  name              String
  description       String             @default("")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items             PlaylistItem[]
  schedules         Schedule[]
  publishedReleases PublishedRelease[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model PlaylistItem {
  id                 String              @id @default(cuid())
  organizationId     String
  playlistId         String
  assetId            String
  position           Int
  durationSeconds    Int
  playlist           Playlist            @relation(fields: [playlistId, organizationId], references: [id, organizationId], onDelete: Cascade)
  asset              MediaAsset          @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: NoAction)
  frozenReleaseItems FrozenReleaseItem[]

  @@unique([id, organizationId])
  @@unique([playlistId, position])
}

model Schedule {
  id                   String                       @id @default(cuid())
  organizationId       String
  playlistId           String
  name                 String
  priority             SchedulePriority             @default(NORMAL)
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String                       @default("UTC")
  daysOfWeek           Int[]                        @default([])
  dailyStartMinutes    Int?
  dailyEndMinutes      Int?
  enabled              Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playlist             Playlist                     @relation(fields: [playlistId, organizationId], references: [id, organizationId], onDelete: Cascade)
  targets              ScheduleTarget[]
  releaseAssignments   ReleaseAssignment[]
  candidatePublication ReleaseCandidatePublication?

  @@unique([id, organizationId])
  @@index([organizationId, startsAt, endsAt])
}

model ScheduleTarget {
  organizationId String
  scheduleId     String
  screenId       String
  schedule       Schedule @relation(fields: [scheduleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  screen         Screen   @relation(fields: [screenId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([scheduleId, screenId])
}

model PublishedRelease {
  id                        String                @id @default(cuid())
  organizationId            String
  sourcePlaylistId          String
  sourcePlaylistName        String
  sourcePlaylistDescription String
  sourcePlaylistUpdatedAt   DateTime
  digestSha256              String
  createdById               String
  createdAt                 DateTime              @default(now())
  organization              Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourcePlaylist            Playlist              @relation(fields: [sourcePlaylistId, organizationId], references: [id, organizationId], onDelete: NoAction)
  createdBy                 MembershipAttribution @relation("PublishedReleaseCreatorAttribution", fields: [organizationId, createdById], references: [organizationId, userId], onDelete: NoAction)
  items                     FrozenReleaseItem[]
  assignments               ReleaseAssignment[]
  candidates                ReleaseCandidate[]

  @@unique([id, organizationId])
  @@unique([organizationId, digestSha256])
  @@index([organizationId, createdAt])
}

model ReleaseCandidate {
  id                String                       @id @default(cuid())
  organizationId    String
  releaseId         String
  state             ReleaseCandidateState        @default(DRAFT)
  digestSha256      String
  authorUserId      String
  scheduleName      String
  priority          SchedulePriority
  startsAt          DateTime
  endsAt            DateTime?
  timezone          String
  daysOfWeek        Int[]
  dailyStartMinutes Int?
  dailyEndMinutes   Int?
  enabled           Boolean
  policyVersion     Int                          @default(1)
  expiresAt         DateTime
  submittedAt       DateTime?
  approvedAt        DateTime?
  publishedAt       DateTime?
  publicationId     String?                      @unique
  createdAt         DateTime                     @default(now())
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release           PublishedRelease             @relation(fields: [releaseId, organizationId], references: [id, organizationId], onDelete: NoAction)
  author            MembershipAttribution        @relation("ReleaseCandidateAuthorAttribution", fields: [organizationId, authorUserId], references: [organizationId, userId], onDelete: NoAction)
  targets           ReleaseCandidateTarget[]
  approval          ReleaseApproval?
  publication       ReleaseCandidatePublication? @relation("PublicationCandidateEvidence")
  finalPublication  ReleaseCandidatePublication? @relation("CandidateFinalPublication", fields: [publicationId, id, organizationId], references: [id, candidateId, organizationId], onDelete: NoAction)

  @@unique([id, organizationId])
  @@unique([publicationId, id, organizationId])
  @@index([organizationId, digestSha256])
  @@index([organizationId, state, expiresAt])
}

model ReleaseCandidateTarget {
  organizationId           String
  candidateId              String
  screenId                 String
  liveScreenId             String?
  liveScreenOrganizationId String?
  candidate                ReleaseCandidate @relation(fields: [candidateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  liveScreen               Screen?          @relation(fields: [liveScreenId, liveScreenOrganizationId], references: [id, organizationId], onDelete: SetNull)

  @@id([candidateId, screenId])
  @@index([organizationId, screenId])
}

model ReleaseApproval {
  id                    String                @id @default(cuid())
  organizationId        String
  candidateId           String
  candidateDigestSha256 String
  approverUserId        String
  authenticationEpoch   Int
  authorizationEpoch    Int
  approvedAt            DateTime              @default(now())
  candidate             ReleaseCandidate      @relation(fields: [candidateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  approver              MembershipAttribution @relation("ReleaseApprovalApproverAttribution", fields: [organizationId, approverUserId], references: [organizationId, userId], onDelete: NoAction)

  @@unique([id, organizationId])
  @@unique([candidateId, organizationId])
  @@index([organizationId, approverUserId])
}

model ReleaseCandidatePublication {
  id                  String                @id @default(cuid())
  organizationId      String
  candidateId         String
  scheduleId          String
  assignmentId        String
  publisherUserId     String
  publishedAt         DateTime              @default(now())
  candidate           ReleaseCandidate      @relation("PublicationCandidateEvidence", fields: [candidateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  publishedCandidate  ReleaseCandidate?     @relation("CandidateFinalPublication")
  schedule            Schedule              @relation(fields: [scheduleId, organizationId], references: [id, organizationId], onDelete: NoAction)
  assignment          ReleaseAssignment     @relation("PublicationAssignmentEvidence", fields: [assignmentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  publishedAssignment ReleaseAssignment?    @relation("AssignmentFinalPublication")
  publisher           MembershipAttribution @relation("ReleaseCandidatePublisherAttribution", fields: [organizationId, publisherUserId], references: [organizationId, userId], onDelete: NoAction)

  @@unique([id, organizationId])
  @@unique([candidateId, organizationId])
  @@unique([scheduleId, organizationId])
  @@unique([assignmentId, organizationId])
  @@unique([id, candidateId, organizationId])
  @@unique([id, assignmentId, organizationId])
  @@index([organizationId, publishedAt])
}

model FrozenReleaseItem {
  id                   String           @id @default(cuid())
  organizationId       String
  releaseId            String
  sourcePlaylistItemId String
  sourceAssetId        String
  assetName            String
  assetKind            MediaKind
  assetMimeType        String
  assetUrl             String
  assetStorageKey      String
  assetChecksumSha256  String
  assetSizeBytes       BigInt
  assetCreatedAt       DateTime
  assetExpiresAt       DateTime?
  position             Int
  durationSeconds      Int
  createdAt            DateTime         @default(now())
  release              PublishedRelease @relation(fields: [releaseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sourcePlaylistItem   PlaylistItem     @relation(fields: [sourcePlaylistItemId, organizationId], references: [id, organizationId], onDelete: NoAction)
  sourceAsset          MediaAsset       @relation(fields: [sourceAssetId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([releaseId, position])
  @@index([organizationId, sourceAssetId])
}

model ReleaseAssignment {
  id                             String                       @id @default(cuid())
  organizationId                 String
  releaseId                      String
  scheduleId                     String
  state                          ReleaseAssignmentState
  digestSha256                   String
  previousAssignmentId           String?                      @unique
  createdById                    String
  scheduleName                   String
  priority                       SchedulePriority
  startsAt                       DateTime
  endsAt                         DateTime?
  timezone                       String
  daysOfWeek                     Int[]
  dailyStartMinutes              Int?
  dailyEndMinutes                Int?
  enabled                        Boolean
  approvalRequired               Boolean                      @default(true)
  candidatePublicationId         String?                      @unique
  expectedWithdrawalDigestSha256 String?
  createdAt                      DateTime                     @default(now())
  organization                   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release                        PublishedRelease             @relation(fields: [releaseId, organizationId], references: [id, organizationId], onDelete: NoAction)
  schedule                       Schedule                     @relation(fields: [scheduleId, organizationId], references: [id, organizationId], onDelete: NoAction)
  createdBy                      MembershipAttribution        @relation("ReleaseAssignmentCreatorAttribution", fields: [organizationId, createdById], references: [organizationId, userId], onDelete: NoAction)
  previousAssignment             ReleaseAssignment?           @relation("ReleaseAssignmentHistory", fields: [previousAssignmentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  nextAssignments                ReleaseAssignment[]          @relation("ReleaseAssignmentHistory")
  candidatePublication           ReleaseCandidatePublication? @relation("PublicationAssignmentEvidence")
  finalPublication               ReleaseCandidatePublication? @relation("AssignmentFinalPublication", fields: [candidatePublicationId, id, organizationId], references: [id, assignmentId, organizationId], onDelete: NoAction)
  targets                        ReleaseAssignmentTarget[]

  @@unique([id, organizationId])
  @@unique([candidatePublicationId, id, organizationId])
  @@index([organizationId, scheduleId, createdAt])
  @@index([organizationId, releaseId])
}

model ReleaseAssignmentTarget {
  organizationId           String
  assignmentId             String
  screenId                 String
  liveScreenId             String?
  liveScreenOrganizationId String?
  assignment               ReleaseAssignment @relation(fields: [assignmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  liveScreen               Screen?           @relation(fields: [liveScreenId, liveScreenOrganizationId], references: [id, organizationId], onDelete: SetNull)

  @@id([assignmentId, screenId])
  @@index([organizationId, screenId])
}

model EmergencyOverride {
  id              String       @id @default(cuid())
  organizationId  String
  title           String
  message         String
  backgroundColor String       @default("#C1121F")
  targetScreenIds String[]
  startsAt        DateTime     @default(now())
  expiresAt       DateTime
  clearedAt       DateTime?
  createdById     String
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt, clearedAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  actorType      String
  action         String
  entityType     String
  entityId       String?
  ipAddress      String?
  requestId      String?
  /// A custom migration bounds scalar fields and JSON shape/size because
  /// Prisma cannot express those checks or the local mutation guard trigger.
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt, id])
}
