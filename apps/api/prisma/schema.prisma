generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  PUBLISHER
  VIEWER
}

enum ScreenStatus {
  ONLINE
  WARNING
  OFFLINE
  FALLBACK
}

enum Orientation {
  LANDSCAPE
  PORTRAIT
}

enum MediaKind {
  IMAGE
  VIDEO
  WEB
  TEMPLATE
}

enum SchedulePriority {
  NORMAL
  CAMPAIGN
  PRIORITY
  EMERGENCY
}

enum PairingStatus {
  PENDING
  CLAIMED
  EXPIRED
  REVOKED
}

enum PairingPurpose {
  NEW_SCREEN
  REENROLL
}

enum ReleaseAssignmentState {
  ASSIGNED
  WITHDRAWN
}

enum DeviceAuthOperation {
  HEARTBEAT
  MANIFEST
}

enum LoginFailureReason {
  INVALID_CREDENTIALS
  RATE_LIMITED
}

enum IdempotencyOperation {
  SCHEDULE_PUBLISH
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  memberships          Membership[]
  locations            Location[]
  screens              Screen[]
  media                MediaAsset[]
  playlists            Playlist[]
  schedules            Schedule[]
  pairings             PairingCode[]
  emergencies          EmergencyOverride[]
  audits               AuditEvent[]
  publishedReleases    PublishedRelease[]
  releaseAssignments   ReleaseAssignment[]
  deviceCredentials    DeviceCredential[]
  deviceAuthChallenges DeviceAuthChallenge[]
  pairingAttempts      PairingAttempt[]
  idempotencyRecords   IdempotencyRecord[]
}

model IdempotencyRecord {
  id                  String               @id @default(cuid())
  organizationId      String
  operation           IdempotencyOperation
  keyHash             String
  actorUserId         String
  requestDigestSha256 String
  statusCode          Int
  responseBody        Json?
  expiresAt           DateTime
  createdAt           DateTime             @default(now())
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, operation, keyHash])
  @@index([expiresAt])
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  screens        Screen[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
}

model User {
  id                  String       @id @default(cuid())
  /// A custom migration also enforces UNIQUE (LOWER(email)); Prisma cannot
  /// currently express this functional index in the schema DSL.
  email               String       @unique
  name                String
  passwordHash        String
  authenticationEpoch Int          @default(0)
  disabledAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  memberships         Membership[]
  audits              AuditEvent[]
}

model Membership {
  id                 String              @id @default(cuid())
  organizationId     String
  userId             String
  role               OrgRole
  authorizationEpoch Int                 @default(0)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishedReleases  PublishedRelease[]  @relation("PublishedReleaseCreatorMembership")
  releaseAssignments ReleaseAssignment[] @relation("ReleaseAssignmentCreatorMembership")
  userSessions       UserSession[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model LoginFailureEvent {
  id         String             @id @default(cuid())
  accountKey String
  sourceKey  String
  reason     LoginFailureReason
  occurredAt DateTime           @default(now())

  @@index([accountKey, occurredAt])
  @@index([sourceKey, occurredAt])
  @@index([occurredAt])
}

model UserSession {
  id                  String     @id @default(cuid())
  organizationId      String
  userId              String
  tokenHash           String     @unique
  authenticationEpoch Int
  authorizationEpoch  Int
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime   @default(now())
  membership          Membership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([expiresAt])
}

model Screen {
  id                       String                    @id @default(cuid())
  organizationId           String
  name                     String
  location                 String                    @default("")
  locationId               String?
  status                   ScreenStatus              @default(OFFLINE)
  orientation              Orientation               @default(LANDSCAPE)
  resolution               String                    @default("1920x1080")
  tags                     String[]                  @default([])
  installationId           String?                   @unique
  deviceTokenHash          String?
  model                    String?
  osVersion                String?
  playerVersion            String?
  manifestVersion          String?
  nowPlayingAssetId        String?
  uptimeSeconds            BigInt?
  freeStorageBytes         BigInt?
  networkType              String?
  lastSeenAt               DateTime?
  credentialRevokedAt      DateTime?
  credentialGeneration     Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classifiedLocation       Location?                 @relation(fields: [locationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  schedules                ScheduleTarget[]
  pairingCodes             PairingCode[]             @relation("PairingResultScreen")
  reenrollmentGrants       PairingCode[]             @relation("PairingTargetScreen")
  releaseAssignmentTargets ReleaseAssignmentTarget[]
  deviceCredentials        DeviceCredential[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, locationId])
}

model PairingCode {
  id                      String           @id @default(cuid())
  organizationId          String
  screenId                String?
  screenOrganizationId    String?
  purpose                 PairingPurpose   @default(NEW_SCREEN)
  targetScreenId          String?
  targetScreenReferenceId String?
  targetOrganizationId    String?
  expectedGeneration      Int?
  authorizedByUserId      String?
  priorCredentialId       String?
  requestReason           String?
  codeHash                String
  status                  PairingStatus    @default(PENDING)
  expiresAt               DateTime
  claimedAt               DateTime?
  createdAt               DateTime         @default(now())
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  screen                  Screen?          @relation("PairingResultScreen", fields: [screenId, screenOrganizationId], references: [id, organizationId], onDelete: SetNull)
  targetScreen            Screen?          @relation("PairingTargetScreen", fields: [targetScreenId, targetOrganizationId], references: [id, organizationId], onDelete: SetNull)
  attempts                PairingAttempt[]

  @@unique([id, organizationId])
  @@index([organizationId, status, expiresAt])
  @@index([codeHash])
  @@index([targetScreenId, targetOrganizationId, status])
}

model DeviceCredential {
  id                       String                @id @default(cuid())
  organizationId           String
  screenId                 String
  liveScreenId             String?
  liveScreenOrganizationId String?
  keyId                    String                @unique
  publicKeySpki            Bytes
  algorithm                String                @default("ES256")
  securityLevel            String
  expiresAt                DateTime?
  revokedAt                DateTime?
  createdAt                DateTime              @default(now())
  organization             Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  liveScreen               Screen?               @relation(fields: [liveScreenId, liveScreenOrganizationId], references: [id, organizationId], onDelete: SetNull)
  challenges               DeviceAuthChallenge[]
  pairingAttempt           PairingAttempt?

  @@unique([id, organizationId])
  @@unique([liveScreenId, liveScreenOrganizationId])
  @@index([organizationId, liveScreenId, revokedAt, expiresAt])
  @@index([organizationId, screenId, createdAt])
}

/// Organization-independent key history. This intentionally survives tenant
/// deletion so a previously enrolled hardware key can never be reused.
model DeviceKeyTombstone {
  keyId       String   @id
  firstSeenAt DateTime @default(now())
}

model PairingAttempt {
  id                     String            @id
  organizationId         String
  pairingCodeId          String
  keyId                  String
  publicKeySpki          Bytes
  algorithm              String            @default("ES256")
  securityLevel          String
  credentialExpiresAt    DateTime?
  challengeHashSha256    String            @unique
  /// Domain-separated HMAC-SHA256 using PAIRING_CODE_PEPPER; never a plain code digest.
  transcriptDigestSha256 String
  expiresAt              DateTime
  consumedAt             DateTime?
  provedAt               DateTime?
  activatedAt            DateTime?
  cancelledAt            DateTime?
  installationId         String?
  model                  String?
  osVersion              String?
  playerVersion          String?
  boundCredentialId      String?
  createdAt              DateTime          @default(now())
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pairingCode            PairingCode       @relation(fields: [pairingCodeId, organizationId], references: [id, organizationId], onDelete: Cascade)
  boundCredential        DeviceCredential? @relation(fields: [boundCredentialId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([boundCredentialId, organizationId])
  @@index([organizationId, pairingCodeId, expiresAt, consumedAt])
  @@index([expiresAt])
}

model DeviceAuthChallenge {
  id                  String              @id
  organizationId      String
  credentialId        String
  challengeHashSha256 String              @unique
  operation           DeviceAuthOperation
  requestDigestSha256 String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime            @default(now())
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credential          DeviceCredential    @relation(fields: [credentialId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, credentialId, expiresAt, consumedAt])
  @@index([expiresAt])
}

model MediaAsset {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String
  kind               MediaKind
  mimeType           String
  url                String
  storageKey         String
  checksumSha256     String
  sizeBytes          BigInt
  durationSeconds    Int?
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playlistItems      PlaylistItem[]
  frozenReleaseItems FrozenReleaseItem[]

  @@unique([id, organizationId])
  @@unique([organizationId, storageKey])
  @@index([organizationId, createdAt])
}

model Playlist {
  id                String             @id @default(cuid())
  organizationId    String
  name              String
  description       String             @default("")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items             PlaylistItem[]
  schedules         Schedule[]
  publishedReleases PublishedRelease[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model PlaylistItem {
  id                 String              @id @default(cuid())
  organizationId     String
  playlistId         String
  assetId            String
  position           Int
  durationSeconds    Int
  playlist           Playlist            @relation(fields: [playlistId, organizationId], references: [id, organizationId], onDelete: Cascade)
  asset              MediaAsset          @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  frozenReleaseItems FrozenReleaseItem[]

  @@unique([id, organizationId])
  @@unique([playlistId, position])
}

model Schedule {
  id                 String              @id @default(cuid())
  organizationId     String
  playlistId         String
  name               String
  priority           SchedulePriority    @default(NORMAL)
  startsAt           DateTime
  endsAt             DateTime?
  timezone           String              @default("UTC")
  daysOfWeek         Int[]               @default([])
  dailyStartMinutes  Int?
  dailyEndMinutes    Int?
  enabled            Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  playlist           Playlist            @relation(fields: [playlistId, organizationId], references: [id, organizationId], onDelete: Cascade)
  targets            ScheduleTarget[]
  releaseAssignments ReleaseAssignment[]

  @@unique([id, organizationId])
  @@index([organizationId, startsAt, endsAt])
}

model ScheduleTarget {
  organizationId String
  scheduleId     String
  screenId       String
  schedule       Schedule @relation(fields: [scheduleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  screen         Screen   @relation(fields: [screenId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([scheduleId, screenId])
}

model PublishedRelease {
  id                        String              @id @default(cuid())
  organizationId            String
  sourcePlaylistId          String
  sourcePlaylistName        String
  sourcePlaylistDescription String
  sourcePlaylistUpdatedAt   DateTime
  digestSha256              String
  createdById               String
  createdAt                 DateTime            @default(now())
  organization              Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourcePlaylist            Playlist            @relation(fields: [sourcePlaylistId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy                 Membership          @relation("PublishedReleaseCreatorMembership", fields: [organizationId, createdById], references: [organizationId, userId], onDelete: Restrict)
  items                     FrozenReleaseItem[]
  assignments               ReleaseAssignment[]

  @@unique([id, organizationId])
  @@unique([organizationId, digestSha256])
  @@index([organizationId, createdAt])
}

model FrozenReleaseItem {
  id                   String           @id @default(cuid())
  organizationId       String
  releaseId            String
  sourcePlaylistItemId String
  sourceAssetId        String
  assetName            String
  assetKind            MediaKind
  assetMimeType        String
  assetUrl             String
  assetStorageKey      String
  assetChecksumSha256  String
  assetSizeBytes       BigInt
  assetCreatedAt       DateTime
  assetExpiresAt       DateTime?
  position             Int
  durationSeconds      Int
  createdAt            DateTime         @default(now())
  release              PublishedRelease @relation(fields: [releaseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sourcePlaylistItem   PlaylistItem     @relation(fields: [sourcePlaylistItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceAsset          MediaAsset       @relation(fields: [sourceAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([releaseId, position])
  @@index([organizationId, sourceAssetId])
}

model ReleaseAssignment {
  id                   String                    @id @default(cuid())
  organizationId       String
  releaseId            String
  scheduleId           String
  state                ReleaseAssignmentState
  digestSha256         String
  previousAssignmentId String?                   @unique
  createdById          String
  scheduleName         String
  priority             SchedulePriority
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String
  daysOfWeek           Int[]
  dailyStartMinutes    Int?
  dailyEndMinutes      Int?
  enabled              Boolean
  createdAt            DateTime                  @default(now())
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  release              PublishedRelease          @relation(fields: [releaseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  schedule             Schedule                  @relation(fields: [scheduleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy            Membership                @relation("ReleaseAssignmentCreatorMembership", fields: [organizationId, createdById], references: [organizationId, userId], onDelete: Restrict)
  previousAssignment   ReleaseAssignment?        @relation("ReleaseAssignmentHistory", fields: [previousAssignmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  nextAssignments      ReleaseAssignment[]       @relation("ReleaseAssignmentHistory")
  targets              ReleaseAssignmentTarget[]

  @@unique([id, organizationId])
  @@index([organizationId, scheduleId, createdAt])
  @@index([organizationId, releaseId])
}

model ReleaseAssignmentTarget {
  organizationId           String
  assignmentId             String
  screenId                 String
  liveScreenId             String?
  liveScreenOrganizationId String?
  assignment               ReleaseAssignment @relation(fields: [assignmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  liveScreen               Screen?           @relation(fields: [liveScreenId, liveScreenOrganizationId], references: [id, organizationId], onDelete: SetNull)

  @@id([assignmentId, screenId])
  @@index([organizationId, screenId])
}

model EmergencyOverride {
  id              String       @id @default(cuid())
  organizationId  String
  title           String
  message         String
  backgroundColor String       @default("#C1121F")
  targetScreenIds String[]
  startsAt        DateTime     @default(now())
  expiresAt       DateTime
  clearedAt       DateTime?
  createdById     String
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt, clearedAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  actorType      String
  action         String
  entityType     String
  entityId       String?
  ipAddress      String?
  requestId      String?
  /// A custom migration bounds scalar fields and JSON shape/size because
  /// Prisma cannot express those checks or the local mutation guard trigger.
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt, id])
}
