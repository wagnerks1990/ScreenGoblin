NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://screengoblin:screengoblin@localhost:5432/screengoblin?schema=public
REDIS_URL=redis://localhost:6379/0
# Generate independent API secrets, for example with: openssl rand -base64 48
# Production startup rejects these placeholders and checked-in test values.
JWT_SECRET=replace-with-at-least-32-random-characters
PAIRING_CODE_PEPPER=replace-with-a-separate-at-least-32-character-secret
MEDIA_DELIVERY_SECRET=replace-with-a-third-at-least-32-character-secret
# Browser/PWA prototype only. Production must use proof-v1.
DEVICE_AUTH_MODE=development-bearer
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
# Production startup rejects the all-zero seed used by automated tests.
MANIFEST_SIGNING_PRIVATE_KEY=replace-with-a-base64url-encoded-32-byte-seed
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://localhost,capacitor://localhost
PUBLIC_API_URL=http://localhost:3000
# Empty denies all media creation. List exact origins only; production requires HTTPS non-local DNS names.
MEDIA_ALLOWED_ORIGINS=https://localhost
# Private, fixed-endpoint object delivery. Browser upload/ingestion remains disabled.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=screengoblin-media
S3_ACCESS_KEY_ID=replace-with-private-media-access-key
S3_SIGNING_KEY=replace-with-private-media-secret-key
LOG_LEVEL=info
TRUST_PROXY_RANGES=
EMERGENCY_FEATURE_ENABLED=false
SEED_ADMIN_EMAIL=admin@screengoblin.local
SEED_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
SEED_ADMIN_NAME=Local Administrator
SEED_ORGANIZATION_NAME=Local ScreenGoblin
SEED_ORGANIZATION_SLUG=local-screengoblin
