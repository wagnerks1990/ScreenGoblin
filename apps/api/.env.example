NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://screengoblin:screengoblin@localhost:5432/screengoblin?schema=public
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
PAIRING_CODE_PEPPER=replace-with-a-separate-at-least-32-character-secret
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MANIFEST_SIGNING_PRIVATE_KEY=replace-with-a-base64url-encoded-32-byte-seed
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://localhost,capacitor://localhost
PUBLIC_API_URL=http://localhost:3000
MEDIA_ALLOWED_ORIGINS=https://localhost
LOG_LEVEL=info
TRUST_PROXY_RANGES=
EMERGENCY_FEATURE_ENABLED=false
SEED_ADMIN_EMAIL=admin@screengoblin.local
SEED_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
SEED_ADMIN_NAME=Local Administrator
SEED_ORGANIZATION_NAME=Local ScreenGoblin
SEED_ORGANIZATION_SLUG=local-screengoblin
