{
  "name": "@screengoblin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build:contracts": "npm run build -w @screengoblin/contracts",
    "predev": "npm run build:contracts",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build:contracts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src test integration vitest.config.ts vitest.integration.config.ts --max-warnings=0",
    "pretypecheck": "npm run build:contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "npm run build:contracts",
    "test": "vitest run",
    "pretest:coverage": "npm run build:contracts",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run build:contracts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.12.0",
    "@screengoblin/contracts": "*",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.2",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.11.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.0"
  }
}
